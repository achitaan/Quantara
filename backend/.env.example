DATABASE_URL=sqlite:///./runtime/quantara.db
RUNTIME_DIR=runtime
DEMO_MODE=true
TEAM_USERNAME=demo
TEAM_PASSWORD=quantara-local-demo
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:4b
LLM_TIMEOUT=180
LLM_MAX_TOKENS=600
LLM_KEEP_ALIVE=30m
OLLAMA_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TASK_BACKEND=local
REDIS_URL=redis://localhost:6379/0
# Optional: ALPACA_KEY, ALPACA_SECRET, PLAID_CLIENT_ID, PLAID_SECRET
# Hosted inference is opt-in: LLM_PROVIDER=hosted, HOSTED_LLM_URL, HOSTED_LLM_KEY
